# Абсолютный адрес сайта без слэша в конце.
# Заполните после покупки домена и заново выполните сборку: yarn build
VITE_SITE_URL=

# Код из Яндекс Вебмастера: Настройки → Подтверждение прав → Meta-тег
VITE_YANDEX_VERIFICATION=

# Код из Google Search Console: подтверждение способом HTML-тег
VITE_GOOGLE_VERIFICATION=
